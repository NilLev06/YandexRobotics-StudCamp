# Настройки телеметрии ровера. Подхватываются scripts/run_telemetry.sh,
# scripts/upload_telemetry.sh и systemd-сервисом rbm-telemetry.

# 0 = телеметрия полностью выключена (сервис стартует и сразу выходит)
TELEMETRY_ENABLED=1

# Куда писать локальный буфер на ровере
TELEMETRY_DIR=/home/robomarvel/rover-logs

# Сервер для выгрузки, формат rsync/ssh: user@host:/path/to/rover-logs
# Пусто = не выгружать, хранить локально в пределах капа
TELEMETRY_REMOTE=

# Локальный кап на все сессии, ГБ (старые сессии удаляются автоматически)
TELEMETRY_CAP_GB=10

# Порог свободного места на диске, ГБ: ниже него запись останавливается
TELEMETRY_MIN_FREE_GB=2

# Длительность одной сессии, секунд (после чего сессия закрывается и
# становится доступной аплоадеру; сервис тут же открывает следующую)
TELEMETRY_SESSION_SECONDS=3600

# URL /health эндпоинта YOLO-сайдкара (на хосте проброшен как 8092)
TELEMETRY_YOLO_URL=http://127.0.0.1:8092/health
