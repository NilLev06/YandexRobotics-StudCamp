# Non-secret rover runtime settings. Yandex credentials live separately in
# yandex-cloud.env; see yandex-cloud.env.example.
ROVER_CAMERA_URL=rtsp://127.0.0.1:8554/cam
CAMERA_SNAPSHOT_JPEG_QUALITY=85
CAMERA_SNAPSHOT_TIMEOUT_MS=5000

# Required only for real dispatch. Use the exact YOLO class names deployed on GFS-X.
# UNITY_API_URL=http://192.168.2.100:8088/api/m2m
# GFSX_ALLOWED_CLASSES=bottle,cup,box
